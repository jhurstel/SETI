{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // Jest (ts-jest) exécute les tests en CommonJS ; l'application, elle, est un module ES (Vite)
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "..",
    "types": ["jest", "node"]
  },
  "include": ["./**/*.ts", "../src/**/*"]
}
